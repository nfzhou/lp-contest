% https://github.com/nfzhou/lp-contest/Centered_Door.pdf
%
% to run, picat cenered_door < instance_file

% generated by ChatGPT 5.5, prompted by Cristian Grozea


main =>
    Ne = read_int(),
    Me = read_int(),

    Edges = [],
    Total = 0,
    foreach (_ in 1..Me)
        A = read_int() + 1,
        B = read_int() + 1,
        L = read_int(),
        Total := Total + L,
        Edges := [$edge(L,A,B) | Edges]
    end,

    SortedEdges = sort(Edges),
    KeepCost = mst_cost(Ne, SortedEdges),
    Cable = Total - KeepCost,

    Ns = read_int(),
    Ms = read_int(),

    Adj = new_array(Ns),
    foreach (I in 1..Ns)
        Adj[I] := []
    end,

    foreach (_ in 1..Ms)
        U = read_int() + 1,
        V = read_int() + 1,
        Adj[U] := [V | Adj[U]],
        Adj[V] := [U | Adj[V]]
    end,

    Dist = new_array(Ns),
    foreach (I in 1..Ns)
        Dist[I] := read_int()
    end,

    Ans = exit_answer(Ns, Adj, Dist, Cable),
    println(Ans).

% Maximum removable entrance cable =
% total edge length - minimum spanning tree length.
mst_cost(N, Edges) = Cost =>
    Parent = new_array(N),
    Size = new_array(N),

    foreach (I in 1..N)
        Parent[I] := I,
        Size[I] := 1
    end,

    C = 0,
    foreach (E in Edges)
        E = $edge(L,A,B),
        RA = dsu_find(Parent, A),
        RB = dsu_find(Parent, B),
        if (RA != RB) then
            if (Size[RA] < Size[RB]) then
                Parent[RA] := RB,
                Size[RB] := Size[RB] + Size[RA]
            else
                Parent[RB] := RA,
                Size[RA] := Size[RA] + Size[RB]
            end,
            C := C + L
        end
    end,

    Cost = C.

dsu_find(Parent, X) = Root =>
    PX = Parent[X],
    if (PX == X) then
        Root = X
    else
        Root = dsu_find(Parent, PX),
        Parent[X] := Root
    end.

exit_answer(N, Adj, Dist, Cable) = Ans =>
    Parent = new_array(N),
    Sub = new_array(N),
    MaxChild = new_array(N),

    foreach (I in 1..N)
        Parent[I] := 0,
        Sub[I] := 1,
        MaxChild[I] := 0
    end,

    % Iterative DFS from node 1.
    Stack = [1],
    Order = [],
    while (Stack != [])
        [U | Rest] = Stack,
        Stack := Rest,
        Order := [U | Order],

        foreach (V in Adj[U], V != Parent[U])
            Parent[V] := U,
            Stack := [V | Stack]
        end
    end,

    % Post-order accumulation of subtree sizes.
    foreach (U in Order)
        P = Parent[U],
        if (P != 0) then
            Sub[P] := Sub[P] + Sub[U],
            if (Sub[U] > MaxChild[P]) then
                MaxChild[P] := Sub[U]
            end
        end
    end,

    Limit = (N + 1) // 2,
    A = -1,

    foreach (U in 1..N)
        Outside = N - Sub[U],
        BiggestPart = max(Outside, MaxChild[U]),
        if (A == -1, BiggestPart =< Limit, Dist[U] =< Cable) then
            A := U - 1
        end
    end,

    Ans = A.
