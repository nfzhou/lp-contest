% https://github.com/nfzhou/lp-contest/Strawberry_Vanilla.pdf
%
% to run, picat strawberry_vanilla.pi  instance

import sat, util.

main([File]) =>
    [Line1|Lines] = read_file_lines(File),
    [NR,NC] = [to_int(Token) : Token in split(Line1)],
    ClueM = {Row : Line in Lines, Row = {to_int(Token) : Token in split(Line)}},
    M = new_array(NR, NC),
    M :: 0..1,   % 1 means strawberry and 0 means vanilla
    constrain_strawberry_rectangles(M, NR, NC),
    constrain_no_vanilla_rectangles(M, NR, NC),
    constrain_clues(ClueM, M, NR, NC),    
    solve(M),
    print_grid(M, NR, NC).

% For each 2x2 rectangle, it cannot be
%   0 1     or     1 0      or     1  1    or    1  1
%   1 1            1 1             1  0          0  1
%
constrain_strawberry_rectangles(M, NR, NC) =>
    foreach (R in 1..NR-1, C in 1..NC-1)
        M[R,C+1] #/\ M[R+1,C] #/\ M[R+1,C+1] #=> M[R,C],
        M[R,C] #/\ M[R+1,C] #/\ M[R+1,C+1] #=> M[R,C+1],        
        M[R,C] #/\ M[R,C+1] #/\ M[R+1,C] #=> M[R+1,C+1],
        M[R,C] #/\ M[R,C+1] #/\ M[R+1,C+1] #=> M[R,C]
    end.
    
% For each WxH rectangle, if the surrounding cells are all 1, then the rectangle contains at least one 1.
constrain_no_vanilla_rectangles(M, NR, NC) =>
    foreach (R in 1..NR, C in 1..NC, H in 1..NR-R+1, W in 1..NC-C+1)
        collect_surrounding_cells(M, NR, NC, R, C, H, W, Cells),
        Len = len(Cells),
        sum(Cells) #= Len #=> sum([M[R1,C1] : R1 in R..R+H-1, C1 in 1..C+W-1]) #>= 1
    end.

% Cells is a list of cells right outside the rectangle (W x H) at (R, C)
collect_surrounding_cells(M, NR, NC, R, C, H, W, Cells) =>
    Cells1 = [M[R-1,C1] : R-1 >= 1, C1 in C..C+W-1],
    Cells2 = [M[R1,C+W] : C+W =< NC, R1 in R..R+H-1],
    Cells3 = [M[R+H,C1] : R+H =< NR, C1 in C..C+W-1],    
    Cells4 = [M[R1,C-1] : C-1 >= 1, R1 in R..R+H-1],
    Cells = Cells1 ++ Cells2 ++ Cells3 ++ Cells4.

% For each clue number K at (R,C), its block (SCC) has size K.
constrain_clues(ClueM, M, NR, NC) =>
    foreach (R in 1..NR, C in 1..NC, ClueM[R,C] !== 0)
        constrain_clue(M, NR, NC, R, C, ClueM[R,C])
    end.

constrain_clue(M, NR, NC, ClueR, ClueC, K) =>
    Block = new_array(NR, NC),
    Block :: 0..1,
    Block[ClueR,ClueC] = 1,   % the clue cell must be in the block
    foreach (R in 1..NR, C in 1..NC)
        Block[R,C] #=> M[R,C] #= M[ClueR,ClueC],
        foreach ((R1,C1) in neibs(NR, NC, R, C))
            Block[R,C] #!= Block[R1,C1] #=> M[R,C] #!= M[R1,C1]
        end
    end,
    scc_grid(Block, K).

neibs(NR, NC, R, C) = [(R1,C1) :  (R1,C1) in [(R,C-1),(R,C+1),(R-1,C),(R+1,C)], R1 >= 1, R1 <= NR, C1 >= 1, C1 <= NC].

print_grid(M, NR, NC) =>
    foreach (R in 1..NR)
        foreach (C in 1..NC)
            if C > 1 then
                print(" ")
            end,
            print(M[R,C])
        end,
        nl()
    end.
