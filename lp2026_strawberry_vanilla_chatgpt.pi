% https://github.com/nfzhou/lp-contest/blob/main/Strawberry_Vanilla.pdf
%
% to run, picat strawberry_vanilla_chatgpt.pi  < instance
%
% generated by ChatGPT 5.5, prompted by Cristian Grozea

import sat.

main =>
    R = read_int(),
    C = read_int(),

    Clues = new_array(R, C),
    foreach (I in 1..R, J in 1..C)
        Clues[I,J] := read_int()
    end,

    solve_puzzle(R, C, Clues, X),
    print_grid(X, R, C).

solve_puzzle(R, C, Clues, X) =>
    X = new_array(R, C),
    XVars = [X[I,J] : I in 1..R, J in 1..C],
    XVars :: 0..1,

    post_strawberry_rectangles(X, R, C),

    post_prefix_sums(X, R, C, P, PVars),
    post_no_vanilla_rectangle_components(X, P, R, C),

    ClueList = [{I,J,Clues[I,J]} : I in 1..R, J in 1..C, Clues[I,J] > 0],
    post_clues(ClueList, X, R, C, ClueVars),

    AllVars = XVars ++ PVars ++ ClueVars,

    solve(AllVars),

    validate_solution(X, Clues, R, C).

/*
  A connected component of 1-cells is rectangular iff no 2x2 subgrid
  contains exactly three 1s.
*/
post_strawberry_rectangles(X, R, C) =>
    if R > 1, C > 1 then
        foreach (I in 1..R-1, J in 1..C-1)
            X[I,J] + X[I+1,J] + X[I,J+1] + X[I+1,J+1] #!= 3
        end
    end.

/*
  Prefix sums of strawberry cells.
  P[I,J] = number of 1s in rows 1..I-1 and cols 1..J-1.
*/
post_prefix_sums(X, R, C, P, PVars) =>
    P = new_array(R+1, C+1),
    PVars = [P[I,J] : I in 1..R+1, J in 1..C+1],
    PVars :: 0..R*C,

    foreach (I in 1..R+1)
        P[I,1] #= 0
    end,
    foreach (J in 1..C+1)
        P[1,J] #= 0
    end,

    foreach (I in 2..R+1, J in 2..C+1)
        P[I,J] #= P[I-1,J] + P[I,J-1] - P[I-1,J-1] + X[I-1,J-1]
    end.

/*
  For every possible rectangle:
  it must NOT be exactly one vanilla component.
  So either:
    - at least one inside cell is strawberry, or
    - at least one orthogonal boundary cell is vanilla.
*/
post_no_vanilla_rectangle_components(X, P, R, C) =>
    foreach (R1 in 1..R, R2 in R1..R, C1 in 1..C, C2 in C1..C)
        (
            P[R2+1,C2+1] - P[R1,C2+1] - P[R2+1,C1] + P[R1,C1]
            + sum([1 - X[R1-1,J] : J in C1..C2, R1 > 1])
            + sum([1 - X[R2+1,J] : J in C1..C2, R2 < R])
            + sum([1 - X[I,C1-1] : I in R1..R2, C1 > 1])
            + sum([1 - X[I,C2+1] : I in R1..R2, C2 < C])
        ) #>= 1
    end.

post_clues([], _X, _R, _C, Vars) =>
    Vars = [].

post_clues([{I,J,V}|Rest], X, R, C, Vars) =>
    post_one_clue(I, J, V, X, R, C, Vars1),
    post_clues(Rest, X, R, C, Vars2),
    Vars = Vars1 ++ Vars2.

/*
  For each clue, create Reach cells describing exactly the same-color
  connected component containing the clue.
*/
post_one_clue(RootR, RootC, Size, X, R, C, Vars) =>
    Reach = new_array(R, C),
    Dist = new_array(R, C),

    ReachVars = [Reach[I,J] : I in 1..R, J in 1..C],
    DistVars = [Dist[I,J] : I in 1..R, J in 1..C],

    ReachVars :: 0..1,
    DistVars :: 0..Size-1,

    RootColor = X[RootR,RootC],

    Reach[RootR,RootC] #= 1,
    Dist[RootR,RootC] #= 0,
    sum(ReachVars) #= Size,

    foreach (I in 1..R, J in 1..C)
        Reach[I,J] #=> (X[I,J] #= RootColor),

        foreach ({NI,NJ} in neighbors(I, J, R, C))
            (Reach[I,J] #/\ (X[NI,NJ] #= RootColor)) #=> Reach[NI,NJ]
        end,

        if I == RootR, J == RootC then
            true
        else
            Reach[I,J] #=> (Dist[I,J] #>= 1),
            Reach[I,J] #=>
                (
                    sum([
                        Reach[NI,NJ] #/\ (Dist[NI,NJ] + 1 #= Dist[I,J])
                        : {NI,NJ} in neighbors(I, J, R, C)
                    ]) #>= 1
                )
        end
    end,

    Vars = ReachVars ++ DistVars.

neighbors(I, J, R, C) = Ns =>
    Ns1 = [],
    Ns2 = cond(I > 1,     [{I-1,J}|Ns1], Ns1),
    Ns3 = cond(I < R,     [{I+1,J}|Ns2], Ns2),
    Ns4 = cond(J > 1,     [{I,J-1}|Ns3], Ns3),
    Ns  = cond(J < C,     [{I,J+1}|Ns4], Ns4).

/* Final safety validation. */
validate_solution(X, Clues, R, C) =>
    Seen = new_array(R, C),
    foreach (I in 1..R, J in 1..C)
        Seen[I,J] := 0
    end,

    foreach (I in 1..R, J in 1..C)
        if Seen[I,J] == 0 then
            Color = X[I,J],
            collect_component([{I,J}], X, Seen, R, C, Color, Cells),
            check_component(Cells, Color, Clues)
        end
    end.

collect_component([], _X, _Seen, _R, _C, _Color, Cells) =>
    Cells = [].

collect_component([{I,J}|Queue], X, Seen, R, C, Color, Cells) =>
    if Seen[I,J] == 1 then
        collect_component(Queue, X, Seen, R, C, Color, Cells)
    elseif X[I,J] != Color then
        collect_component(Queue, X, Seen, R, C, Color, Cells)
    else
        Seen[I,J] := 1,
        More = [{NI,NJ} : {NI,NJ} in neighbors(I, J, R, C),
                         Seen[NI,NJ] == 0,
                         X[NI,NJ] == Color],
        collect_component(Queue ++ More, X, Seen, R, C, Color, Rest),
        Cells = [{I,J}|Rest]
    end.

check_component(Cells, Color, Clues) =>
    Size = len(Cells),

    foreach ({I,J} in Cells)
        V = Clues[I,J],
        if V > 0 then
            V == Size
        end
    end,

    Rows = [I : {I,_J} in Cells],
    Cols = [J : {_I,J} in Cells],

    H = max(Rows) - min(Rows) + 1,
    W = max(Cols) - min(Cols) + 1,
    Area = H * W,

    if Color == 1 then
        Area == Size
    else
        Area != Size
    end.

print_grid(X, R, C) =>
    foreach (I in 1..R)
        foreach (J in 1..C)
            if J > 1 then
                print(" ")
            end,
            print(X[I,J])
        end,
        nl()
    end.